{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "baseBranches": [
    "master",
    "main"
  ],
  "dockerfile": {
    "fileMatch": [
      "Dockerfile.dapper"
    ]
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prHourlyLimit": 12,
  "timezone": "Asia/Taipei",
  "schedule": [
    "after 10am on saturday",
    "on sunday"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "minimumReleaseAge": "2 weeks",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "rangeStrategy": "bump"
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "matchManagers": [
        "gomod"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "groupName": "patch digest dependencies"
    },
    {
      "matchPackageNames": [
        "github.com/rancher/dynamiclistener"
      ],
      "allowedVersions": "<0.7.1 || >0.7.1"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "automerge": true,
      "groupName": "docker dependencies"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "package/Dockerfile"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/bci-base"
      ],
      "allowedVersions": "/^15\\.7$/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "enabled": true,
      "automerge": false,
      "groupName": "golang image minor"
    }
  ]
}
